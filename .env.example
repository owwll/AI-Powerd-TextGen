# ============================================================
# Hugging Face API Configuration
# ============================================================
# Hugging Face API token (required)
# Get your token from: https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Hugging Face Endpoint Configuration
HF_ENDPOINT_URL=https://router.huggingface.co/v1
HF_MODEL_ID=Qwen/Qwen2.5-14B-Instruct

# Demo-only Vite env token (optional)
# Set this inside packages/demo/.env.local when you want the browser demo to run without typing a token.
VITE_HF_API_TOKEN=
